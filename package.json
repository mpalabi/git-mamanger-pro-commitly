{
  "name": "git-manager-pro",
  "version": "1.0.3",
  "description": "A global npm package that provides a visual, web-based dashboard for managing Git operations, commits, PRs, and tasks across multiple projects",
  "main": "dist/bin/gmp.js",
  "bin": {
    "gmp": "./dist/bin/gmp.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && npm run build",
    "start": "npm run build:server && node dist/server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node server/index.ts",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "clean": "rm -rf dist",
    "link": "npm link",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "cli",
    "dashboard",
    "version-control",
    "project-management",
    "pr",
    "pull-requests"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "client/dist/**/*"
  ],
  "dependencies": {
    "commander": "^11.0.0",
    "fastify": "^4.21.0",
    "@fastify/cors": "^8.3.0",
    "@fastify/static": "^6.10.0",
    "@fastify/websocket": "^8.3.0",
    "simple-git": "^3.19.0",
    "lowdb": "^5.1.0",
    "chokidar": "^3.5.3",
    "ws": "^8.13.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "boxen": "^7.0.0",
    "node-fetch": "^3.3.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.0",
    "@types/ws": "^8.5.5",
    "@types/uuid": "^9.0.2",
    "@types/inquirer": "^9.0.3",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0",
    "vite": "^4.4.0",
    "@vitejs/plugin-react": "^4.0.0"
  }
}
